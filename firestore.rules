rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: only the user themself can read or change it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Vendor doc id = seller's uid. Anyone signed in can see vendors; only the owner can change theirs.
    match /vendors/{vendorId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.ownerId == request.auth.uid;

      // Menu items: anyone signed in can read; only the vendor owner can change, and stock never goes below 0.
      match /menu/{itemId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == vendorId;
        allow create, update: if request.auth != null && request.auth.uid == vendorId
          && request.resource.data.name is string
          && request.resource.data.price is int && request.resource.data.price > 0
          && request.resource.data.stock is int && request.resource.data.stock >= 0;
      }
    }
    // Everything else is denied until its feature adds a rule.
  }
}
