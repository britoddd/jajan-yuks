rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile: only the user themself can read or change it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Vendor doc id = seller's uid. Anyone signed in can see vendors; only the owner can change theirs.
    match /vendors/{vendorId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.ownerId == request.auth.uid;

      // Menu items: anyone signed in can read; only the vendor owner can change, and stock never goes below 0.
      match /menu/{itemId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == vendorId;
        allow create, update: if request.auth != null && request.auth.uid == vendorId
          && request.resource.data.name is string
          && request.resource.data.price is int && request.resource.data.price > 0
          && request.resource.data.stock is int && request.resource.data.stock >= 0;
      }
    }
    // Orders: only the buyer and the seller of an order can see it.
    match /orders/{orderId} {
      function onlyStatusChanges() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      }
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.vendorId);
      // A buyer creates their own order, always starting as PENDING.
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      // The seller moves it forward; the buyer may only cancel while it is still PENDING.
      allow update: if request.auth != null && onlyStatusChanges() && (
        request.auth.uid == resource.data.vendorId
        || (request.auth.uid == resource.data.buyerId
            && resource.data.status == 'PENDING'
            && request.resource.data.status == 'CANCELLED'));
    }

    // Everything else is denied until its feature adds a rule.
  }
}
